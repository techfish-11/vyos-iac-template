{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Connection metadata only. Network features live in native config.boot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "user",
    "port",
    "version",
    "management_interface",
    "source",
    "secrets",
    "healthcheck_targets"
  ],
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "user": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,31}$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "version": {
      "enum": [
        "1.4",
        "1.5"
      ]
    },
    "management_interface": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "healthcheck_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  }
}
